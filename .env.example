# Copy this file to `.env` and fill in the values.

# --- Telegram API credentials -------------------------------------------
# From https://my.telegram.org -> "API development tools"
API_ID=1234567
API_HASH=0123456789abcdef0123456789abcdef
# From @BotFather
BOT_TOKEN=123456789:AAExampleExampleExampleExampleExample

# --- Admins ---------------------------------------------------------------
# Comma-separated numeric Telegram user ids (get yours from @userinfobot).
# ONLY these ids can use the admin commands (/stats, /broadcast, /ban, ...).
ADMIN_IDS=111111111,222222222

# --- Channels (numeric ids, always start with -100) -----------------------
# Private channel: bot auto-approves join requests and runs the 1-minute loop here.
PRIVATE_CHANNEL_ID=-1001111111111

# The 3 channels users must join to complete the quest.
SECONDARY_CHANNEL_1_ID=-1002222222222
SECONDARY_CHANNEL_1_LINK=https://t.me/your_secondary_channel_1
SECONDARY_CHANNEL_1_TITLE=📢 Channel 1

SECONDARY_CHANNEL_2_ID=-1003333333333
SECONDARY_CHANNEL_2_LINK=https://t.me/your_secondary_channel_2
SECONDARY_CHANNEL_2_TITLE=📢 Channel 2

MAIN_CHANNEL_ID=-1004444444444
MAIN_CHANNEL_LINK=https://t.me/your_main_channel
MAIN_CHANNEL_TITLE=⭐ Main Channel

# Where "🎉 User X just unlocked the private channel!" is posted.
# Optional: defaults to MAIN_CHANNEL_ID.
# ANNOUNCE_CHANNEL_ID=-1004444444444

# --- Reward link ------------------------------------------------------------
# unique    = a single-use link per user (member_limit=1), cannot be re-shared (recommended)
# permanent = one shared link for everybody
INVITE_LINK_MODE=unique
# Only for permanent mode; if empty the bot creates one and remembers it.
# PERMANENT_INVITE_LINK=https://t.me/+xxxxxxxxxxxx

# --- Loop ----------------------------------------------------------------------
LOOP_INTERVAL_SECONDS=60
LOOP_ENABLED=true
LOOP_TEXT=Share to 3 groups to unlock the channel for everyone!

# --- Misc ------------------------------------------------------------------------
# Anti-spam: seconds between two "Verify" presses per user
VERIFY_COOLDOWN_SECONDS=5
# DM users whose join request was approved with a "Start quest" button
WELCOME_DM_ON_JOIN=true
# Post the public unlock announcement (can also be toggled live with /announce)
ANNOUNCE_ENABLED=true
# Where the SQLite DB, Pyrogram session and logs are stored
DATA_DIR=data
